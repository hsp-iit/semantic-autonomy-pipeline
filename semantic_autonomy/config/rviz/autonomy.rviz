# RViz config of the semantic autonomy pipeline: Nav2, the semantic map and the manipulation-approach topics.
# Derived from visual-language-navigation/.../rviz/vlnav.rviz and manipulation-approach/.../rviz/vis.rviz.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Semantic map1
    - /Approach1
    - /Cameras1
    Splitter Ratio: 0.5833333134651184
  Tree Height: 253
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
